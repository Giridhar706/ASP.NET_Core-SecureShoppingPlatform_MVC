<h2>Login</h2>

<form method="post">

<div class="mb-3">
<label>Email</label>
<input name="email" class="form-control" />
</div>

<div class="mb-3">
<label>Password</label>
<input name="password" type="password" class="form-control" />
</div>

<button class="btn btn-primary" type="submit">
Login
</button>

</form>

<h5 class="text-danger">@ViewBag.Message</h5>